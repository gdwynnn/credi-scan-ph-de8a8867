# ─── Required: OpenAI API key (client-side) ──────────────────────────────────
# Get one at https://platform.openai.com/api-keys
# The app reads this via import.meta.env in the browser.
# WARNING: This key is shipped to the browser. Use a personal/dev key only.
VITE_OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override the model (default: gpt-4o-mini)
VITE_OPENAI_MODEL=gpt-4o-mini

# ─── Lovable Cloud / Supabase (auto-provisioned by Lovable) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
