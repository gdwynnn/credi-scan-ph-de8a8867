# ─── Required: Google Gemini API key (client-side, free tier) ────────────────
# Get one at https://aistudio.google.com/app/apikey
# The app reads this via import.meta.env in the browser.
# WARNING: This key is shipped to the browser. Use a personal/dev key only.
VITE_GEMINI_API_KEY=your-gemini-key-here

# Optional: override the model (default: gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-2.0-flash

# ─── Lovable Cloud / Supabase (auto-provisioned by Lovable) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
