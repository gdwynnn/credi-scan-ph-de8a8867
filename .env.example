# ─── Required: Groq API key (client-side, free tier ~30 RPM / 14.4k RPD) ─────
# Get one at https://console.groq.com/keys
# WARNING: This key is shipped to the browser. Use a personal/dev key only.
VITE_GROQ_API_KEY=your-groq-key-here

# Optional: override the model (default: llama-3.3-70b-versatile)
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ─── Lovable Cloud / Supabase (auto-provisioned by Lovable) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
